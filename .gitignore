# ══════════════════════════════════════════════════════════════
# KiriMonoLog .gitignore
# ══════════════════════════════════════════════════════════════

# Python 字节码缓存目录（__pycache__ 文件夹）
# Python 运行时自动生成的编译产物，不需要纳入版本控制
__pycache__/

# Python 字节码文件（.pyc / .pyo / .pyd）
# .pyc 是 .py 编译后的字节码
# .pyo 是优化后的字节码
# .pyd 是 Windows 上的 Python 动态链接库
*.py[cod]

# macOS Finder 目录缓存文件
.DS_Store

# Python / 测试缓存目录
.pytest_cache/
.mypy_cache/

# 覆盖率与临时输出
coverage/
htmlcov/

# 隔离工作区目录
.worktrees/
